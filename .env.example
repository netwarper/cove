# Copy to .env and adjust. All values are optional.

# Port and bind address. Keep HOST as 127.0.0.1 for a local-only app.
# When hosting remotely, put this behind a TLS-terminating reverse proxy and
# set HOST=0.0.0.0 (see README "Hosting remotely").
PORT=3000
HOST=127.0.0.1

# Working directory for all encrypted data. Point this at a cloud-sync folder
# to keep an encrypted copy in Google Drive / Box / Dropbox, e.g.:
#   DATA_DIR="/Users/you/Google Drive/MeetingNotes"
#   DATA_DIR="/Users/you/Dropbox/MeetingNotes"
DATA_DIR=./data

# Max request body in bytes (attachments/images travel as JSON). Default 32 MB.
MAX_BODY=33554432

# Session lifetime in minutes.
SESSION_TTL=240
