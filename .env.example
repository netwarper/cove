# Copy to .env and adjust. All values are optional.

# Port and bind address. Keep HOST as 127.0.0.1 for a local-only app.
# When hosting remotely, put this behind a TLS-terminating reverse proxy and
# set HOST=0.0.0.0 (see README "Hosting remotely").
#
# NOTE: for a durable local address, prefer `node server.js --set-domain <name>`
# over setting PORT here — it stores a stable domain+port in instance.json that
# travels with your data directory. PORT/HOST/DOMAIN below still override it.
PORT=3000
HOST=127.0.0.1
# DOMAIN=notes.localhost

# Working directory for all encrypted data. Point this at a cloud-sync folder
# to keep an encrypted copy in Google Drive / Box / Dropbox, e.g.:
#   DATA_DIR="/Users/you/Google Drive/Cove"
#   DATA_DIR="/Users/you/Dropbox/Cove"
DATA_DIR=./data

# Max request body in bytes (attachments/images travel as JSON). Default 32 MB.
MAX_BODY=33554432

# Session lifetime in minutes.
SESSION_TTL=240

# Inbox HTTP push (optional). Set a long random token to enable POST /api/inbox,
# so a relay / Cloudflare Worker / Slack slash command can add a to-do directly.
# Leave unset to keep the endpoint disabled (the folder inbox still works). See
# docs/slack-inbox.md.
# INBOX_TOKEN=change-me-to-a-long-random-string

# Outbound Slack agenda (optional). A Slack Incoming Webhook URL to post your
# due/overdue to-dos to. You can also set this in-app under Settings → Slack.
# SLACK_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Scheduled encrypted backups. Set AUTO_BACKUP_DIR to enable — ideally a
# DIFFERENT disk or sync folder than DATA_DIR. Backups are the same encrypted
# bundle as a manual export, so no passphrase is needed to produce them.
# AUTO_BACKUP_DIR=/Users/you/Dropbox/Cove-Backups
AUTO_BACKUP_HOURS=24
AUTO_BACKUP_KEEP=7

# Offline viewer auto-write. Cove keeps a fresh, self-contained read-only
# meeting-notes-viewer.html in DATA_DIR (updated on startup, shortly after edits,
# and on shutdown) so a synced data folder can be opened on any device — phone
# included — with just the passphrase, no server or network. The auto-saved copy
# omits inline images (they need the unlock key); "Download viewer (with images)"
# in the app includes them. Set to 0 to turn the auto-write off.
VIEWER_AUTOWRITE=1
