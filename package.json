{
  "name": "meeting-notes",
  "version": "1.0.0",
  "description": "Self-contained, encrypted meeting-notes application. Zero runtime dependencies, portable, works over cloud-sync folders (Google Drive, Box, Dropbox).",
  "main": "server.js",
  "type": "commonjs",
  "scripts": {
    "start": "node server.js",
    "test": "node test/functional.test.js && node test/security.test.js",
    "test:functional": "node test/functional.test.js",
    "test:security": "node test/security.test.js",
    "check": "node scripts/check-quality.js",
    "verify": "npm run check && npm test"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT",
  "private": true
}
